# Telegram API（从 https://my.telegram.org/apps 获取）
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# 目标群组 ID（负数，如 -1001234567890）
TELEGRAM_GROUP_ID=-1001234567890

# AI 配置（三选一，取消对应注释即可）

# Gemini（免费）
#AI_API_KEY=your-gemini-api-key
#AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#AI_MODEL=gemini-2.0-flash

# Groq（免费）
# AI_API_KEY=your-groq-api-key
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# Claude
# AI_API_KEY=sk-ant-xxxxx
# AI_BASE_URL=https://api.anthropic.com/v1/
# AI_MODEL=claude-sonnet-4-6

# DeepSeek（性价比首选）
# AI_API_KEY=sk-xxxxx
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# OpenAI
# AI_API_KEY=sk-xxxxx
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# 角色手机号（国际格式，如 +8613800138000）
CHARACTER_XIAOMING_PHONE=+86xxxxxxxxxx
CHARACTER_LAOWANG_PHONE=+86xxxxxxxxxx

# Telegram 代理（可选；使用 Clash X 时可填 127.0.0.1 和 50656）
# PROXY_HOST=127.0.0.1
# PROXY_PORT=50656

# 回复延迟范围（秒）
REPLY_DELAY_MIN=15
REPLY_DELAY_MAX=60
MIN_SECONDS_BETWEEN_REPLIES=45
MIN_SECONDS_BETWEEN_REPLIES_HUMAN=45
MIN_SECONDS_BETWEEN_REPLIES_CHARACTER=8
MENTION_REPLY_BONUS=0.25
QUIET_WINDOW_SECONDS=180
RECENT_REPLY_WINDOW_SECONDS=90
STALE_PENDING_REPLY_SECONDS=25
SAME_SENDER_STREAK_LIMIT=3
MAX_CONTEXT=12
MAX_HISTORY=80

# 自动发起话题间隔（秒，默认1800=30分钟）
TOPIC_START_DELAY=30
TOPIC_RETRY_DELAY_ON_EMPTY=15
TOPIC_INTERVAL=1800
